
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/tiordache1/tiordache1.github.io/refs/heads/main/NetOASPayments.csv"
  },
  "title": {
  "text": "Net OAS Payments",
  "subtitle": "Canada, 1980 - 2025",
  "font": "Arial",
  "fontSize": 16,
  "fontWeight": "normal",
  "subtitleFont": "Arial",
  "subtitleFontSize": 16,
  "subtitleFontWeight": "normal",
  "subtitleFontStyle": "normal"
},
  "width": 400,
  "height": 300,
  "mark": {
    "type": "line",
    "color": "black"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "temporal",
      "axis": {
        "title": null,
        "format": "%Y",
        "tickCount": {
          "interval": "year",
          "step": 5
        },
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "Net OAS Payments",
      "type": "quantitative",
      "axis": {
        "title": "Net OAS Payments (Nominal Canadian Dollars)",
        "titlePadding": 20,
        "titleFontWeight": "normal",
        "labelExpr": "format(datum.value / 1000000000, '.0f') + 'B'",
        "grid": true
      }
    }
  },
  "config": {
    "axis": {
      "domainColor": "black",
      "tickColor": "black"
    }
  }
}
