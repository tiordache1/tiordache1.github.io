{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://api.worldbank.org/v2/country/kor;jpn;chn/indicator/SP.DYN.IMRT.IN?format=json&per_page=1000&mrnev=1000",
    "format": {"property": "[1]"}
  },
  "title": {
    "text": "Infant Mortality (per 1,000 live births), Select East Asian Countries (1960-2024)"
  },
  "width": 600,
  "height": 300,
  "mark": {"type": "line", "color": "red"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"title": null}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "scale": {"domain": [0, 100]},
      "axis": {
        "title": "Infant Mortality Rate (per 1,000 live births)"
      }
    },
    "color": {
      "field": "country.value",
      "type": "nominal",
      "legend": {"title": null},
      "scale": {"scheme": "observable10"}
    }
  }
}